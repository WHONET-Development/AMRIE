<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Interpretation_CLI</RootNamespace>
    <Version>$(VersionPrefix)26.3.26</Version>
    <ApplicationIcon>AMRIE_Square_No_Text.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="AMRIE_Square_No_Text.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Interpretation Engine\Interpretation Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="amrie.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="amrie">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CreateAmrieAlias" AfterTargets="Build">
    <Copy SourceFiles="$(TargetDir)$(TargetName).exe" DestinationFiles="$(TargetDir)amrie.exe" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="if $(ConfigurationName) == Release (&#xD;&#xA;echo Attempting to sign binary...&#xD;&#xA;signtool.exe sign /tr http://timestamp.sectigo.com /td sha256 /fd sha256 /a &quot;$(TargetDir)$(TargetName).exe&quot;&#xD;&#xA;) else (&#xD;&#xA;echo Signing skipped because we are not in Release mode.&#xD;&#xA;)" ContinueOnError="true" />
  </Target>

</Project>
