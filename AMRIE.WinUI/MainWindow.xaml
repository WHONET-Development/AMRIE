<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="AMRIE.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AMRIE.WinUI"
    xmlns:media="using:Microsoft.UI.Xaml.Media.Imaging"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AMRIE - Antimicrobial Interpretation Engine"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- Main Fluent Navigation -->
        <NavigationView
            x:Name="NavView"
            PaneDisplayMode="Left"
            OpenPaneLength="216"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            SelectionChanged="NavView_SelectionChanged"
            ItemInvoked="NavView_ItemInvoked"
            Background="Transparent"
            Header="{x:Null}">



            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="Single Interpretation"
                    Tag="SingleInterpretation"
                    ToolTipService.ToolTip="Single test interpretation (ad-hoc CLSI, EUCAST, SFM)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EF;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    Content="Batch Processing"
                    Tag="BatchProcessing"
                    ToolTipService.ToolTip="Interpret entire WHONET data files">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    Content="Resource Explorer"
                    Tag="ResourceExplorer"
                    ToolTipService.ToolTip="Browse published breakpoints, expert rules &amp; phenotypes">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Navigation Pane Footer Actions -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="ThemeToggleItem"
                    Content="System theme"
                    SelectsOnInvoked="False"
                    Tapped="ThemeToggleItem_Tapped"
                    ToolTipService.ToolTip="Theme: Use system setting (click to cycle)">
                    <NavigationViewItem.Icon>
                        <FontIcon x:Name="ThemeIcon" Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.ContextFlyout>
                        <MenuFlyout>
                            <RadioMenuFlyoutItem x:Name="SystemThemeMenuItem" Text="Use system setting" Click="ThemeMenuItem_Click" Tag="Default">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE790;" />
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>
                            <RadioMenuFlyoutItem x:Name="LightThemeMenuItem" Text="Light mode" Click="ThemeMenuItem_Click" Tag="Light">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE706;" />
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>
                            <RadioMenuFlyoutItem x:Name="DarkThemeMenuItem" Text="Dark mode" Click="ThemeMenuItem_Click" Tag="Dark">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE708;" />
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>
                        </MenuFlyout>
                    </NavigationViewItem.ContextFlyout>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Main App Body with Fluent curved corner, stroke, and surface shading -->
            <Border
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
                <Frame x:Name="ContentFrame" Margin="0" CacheSize="10">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition>
                                <EntranceNavigationTransitionInfo />
                            </NavigationThemeTransition>
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>
            </Border>
        </NavigationView>
    </Grid>
</Window>
