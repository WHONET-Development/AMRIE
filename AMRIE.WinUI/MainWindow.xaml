<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="AMRIE.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AMRIE.WinUI"
    xmlns:media="using:Microsoft.UI.Xaml.Media.Imaging"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AMRIE - Antimicrobial Interpretation Engine"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Seamless App TitleBar blending with sidebar and window backdrop -->
        <Border x:Name="AppTitleBar" Background="Transparent" BorderThickness="0">
            <Grid Height="40" Padding="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image Width="20" Height="20" Stretch="Uniform">
                        <Image.Source>
                            <BitmapImage UriSource="ms-appx:///Assets/Square44x44Logo.scale-200.png" />
                        </Image.Source>
                    </Image>
                    <TextBlock Text="AMRIE"
                               VerticalAlignment="Center"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock Text="•  Antimicrobial Interpretation Engine"
                               VerticalAlignment="Center"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Fluent Navigation -->
        <NavigationView
            Grid.Row="1"
            x:Name="NavView"
            PaneDisplayMode="Left"
            OpenPaneLength="216"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            SelectionChanged="NavView_SelectionChanged"
            ItemInvoked="NavView_ItemInvoked"
            Background="Transparent"
            Header="{x:Null}">

            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="Single Interpretation"
                    Tag="SingleInterpretation"
                    ToolTipService.ToolTip="Single test interpretation (ad-hoc CLSI, EUCAST, SFM)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE95E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    Content="Batch Processing"
                    Tag="BatchProcessing"
                    ToolTipService.ToolTip="Interpret entire WHONET data files">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    Content="Resource Explorer"
                    Tag="ResourceExplorer"
                    ToolTipService.ToolTip="Browse published breakpoints, expert rules &amp; phenotypes">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Navigation Pane Footer Actions -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="ThemeToggleItem"
                    Content="Light mode"
                    SelectsOnInvoked="False"
                    Tapped="ThemeToggleItem_Tapped"
                    ToolTipService.ToolTip="Switch to Light mode">
                    <NavigationViewItem.Icon>
                        <FontIcon x:Name="ThemeIcon" Glyph="&#xE706;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Main App Body with Fluent curved corner, stroke, and surface shading -->
            <Border
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
                <Frame x:Name="ContentFrame" Margin="0" CacheSize="10">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition>
                                <EntranceNavigationTransitionInfo />
                            </NavigationThemeTransition>
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>
            </Border>
        </NavigationView>
    </Grid>
</Window>
