<ContentDialog
    x:Class="AMRIE.WinUI.Dialogs.ApplicableIntrinsicRulesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AMRIE.WinUI.Models"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    Style="{StaticResource DefaultContentDialogStyle}"
    Title="Applicable Intrinsic Resistance Rules">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1100</x:Double>
    </ContentDialog.Resources>

    <Grid Width="960" MaxHeight="610" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Context & Filter Summary -->
        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8">
            <StackPanel Spacing="2">
                <TextBlock x:Name="SummaryTextBlock"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           FontWeight="Medium"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="CountTextBlock"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Search Box -->
        <TextBox x:Name="SearchBox"
                 Grid.Row="1"
                 PlaceholderText="Search within fetched intrinsic resistance rules (organism, drug, comments)..."
                 TextChanged="SearchBox_TextChanged" />

        <!-- Intrinsic Rules DataGrid -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                MinHeight="250"
                MaxHeight="420">
            <controls:DataGrid x:Name="RulesTable"
                               AutoGenerateColumns="False"
                               CanUserResizeColumns="True"
                               CanUserSortColumns="True"
                               Sorting="RulesTable_Sorting"
                               IsReadOnly="True"
                               SelectionMode="Single"
                               GridLinesVisibility="Horizontal"
                               HeadersVisibility="Column"
                               ColumnHeaderHeight="38"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"
                               HorizontalGridLinesBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                               RowBackground="Transparent"
                               AlternatingRowBackground="{ThemeResource SubtleFillColorTransparentBrush}"
                               BorderThickness="0"
                               Background="Transparent">
                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn Header="Guideline" Binding="{Binding Guideline}" Width="Auto" MinWidth="105" />
                    <controls:DataGridTemplateColumn Header="Organism" Width="Auto" MinWidth="190" CanUserSort="True" Tag="OrganismCode">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:IntrinsicRuleRow">
                                <Grid Padding="12,4" VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind OrganismCode}" FontWeight="Medium" />
                                        <TextBlock Text="{x:Bind OrganismName}"
                                                   ToolTipService.ToolTip="{x:Bind OrganismName}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                    <controls:DataGridTemplateColumn Header="Antibiotic" Width="Auto" MinWidth="175" CanUserSort="True" Tag="AbxCode">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:IntrinsicRuleRow">
                                <Grid Padding="12,4" VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind AbxCode}" FontWeight="Medium" />
                                        <TextBlock Text="{x:Bind AbxName}"
                                                   ToolTipService.ToolTip="{x:Bind AbxName}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                    <controls:DataGridTemplateColumn Header="Exceptions" Width="Auto" MinWidth="160" CanUserSort="True" Tag="Exceptions">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:IntrinsicRuleRow">
                                <Grid Padding="12,6" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Exceptions}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                    <controls:DataGridTemplateColumn Header="Comments" Width="Auto" MinWidth="280" CanUserSort="True" Tag="Comments">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:IntrinsicRuleRow">
                                <Grid Padding="12,6" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Comments}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </Border>

        <Button x:Name="CloseModalButton"
                Grid.Row="3"
                Content="Close"
                Width="100"
                HorizontalAlignment="Right"
                CornerRadius="4" />
    </Grid>
</ContentDialog>

