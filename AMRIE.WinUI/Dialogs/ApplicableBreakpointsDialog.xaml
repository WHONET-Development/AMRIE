<ContentDialog
    x:Class="AMRIE.WinUI.Dialogs.ApplicableBreakpointsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AMRIE.WinUI.Models"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    Style="{StaticResource DefaultContentDialogStyle}"
    Title="Applicable Breakpoints">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1320</x:Double>
    </ContentDialog.Resources>

    <Grid Width="1200" MaxHeight="640" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Context & Filter Summary -->
        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8">
            <StackPanel Spacing="2">
                <TextBlock x:Name="SummaryTextBlock"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           FontWeight="Medium"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="CountTextBlock"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Search & Filter Controls -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox"
                     PlaceholderText="Search within fetched breakpoints (organism, drug, method, guide, site)..."
                     TextChanged="SearchBox_TextChanged" />
            <CheckBox x:Name="HideUndefinedCheck"
                      Grid.Column="1"
                      Content="Hide without breakpoints"
                      ToolTipService.ToolTip="Hide rows where all breakpoints (S, I, R, and SDD) are not available (shown as -)"
                      VerticalAlignment="Center"
                      Checked="HideUndefinedCheck_Changed"
                      Unchecked="HideUndefinedCheck_Changed" />
        </Grid>

        <!-- Breakpoints DataGrid -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                MinHeight="280"
                MaxHeight="450">
            <controls:DataGrid x:Name="BreakpointsTable"
                               AutoGenerateColumns="False"
                               CanUserResizeColumns="True"
                               CanUserSortColumns="True"
                               Sorting="BreakpointsTable_Sorting"
                               IsReadOnly="True"
                               SelectionMode="Single"
                               GridLinesVisibility="Horizontal"
                               HeadersVisibility="Column"
                               ColumnHeaderHeight="38"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"
                               HorizontalGridLinesBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                               RowBackground="Transparent"
                               AlternatingRowBackground="{ThemeResource SubtleFillColorTransparentBrush}"
                               BorderThickness="0"
                               Background="Transparent">
                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn Header="Guide" Binding="{Binding Guidelines}" Width="Auto" MinWidth="70" />
                    <controls:DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="Auto" MinWidth="60" />
                    <controls:DataGridTextColumn Header="Method" Binding="{Binding TestMethod}" Width="Auto" MinWidth="75" />
                    <controls:DataGridTextColumn Header="Potency" Binding="{Binding Potency}" Width="Auto" MinWidth="75" />
                    <controls:DataGridTemplateColumn Header="Organism" Width="Auto" MinWidth="180" CanUserSort="True" Tag="OrganismCode">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:BreakpointRow">
                                <Grid Padding="12,4" VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind OrganismCode}" FontWeight="Medium" />
                                        <TextBlock Text="{x:Bind OrganismName}"
                                                   ToolTipService.ToolTip="{x:Bind OrganismName}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                    <controls:DataGridTextColumn Header="Type" Binding="{Binding BreakpointType}" Width="Auto" MinWidth="75" />
                    <controls:DataGridTemplateColumn Header="Site" Width="Auto" MinWidth="100" CanUserSort="True" Tag="SiteOfInfection">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:BreakpointRow">
                                <Grid Padding="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind SiteOfInfection}"
                                               ToolTipService.ToolTip="{x:Bind SiteOfInfection}" />
                                </Grid>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                    <controls:DataGridTemplateColumn Header="Antibiotic" Width="Auto" MinWidth="165" CanUserSort="True" Tag="AbxCode">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:BreakpointRow">
                                <Grid Padding="12,4" VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind AbxCode}" FontWeight="Medium" />
                                        <TextBlock Text="{x:Bind AbxName}"
                                                   ToolTipService.ToolTip="{x:Bind AbxName}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                    <controls:DataGridTemplateColumn Header="R" Width="Auto" MinWidth="65" CanUserSort="True" Tag="R">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:BreakpointRow">
                                <Grid Padding="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind RDisplay}" Foreground="{ThemeResource ResistantTextBrush}" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                    <controls:DataGridTextColumn Header="I" Binding="{Binding IDisplay}" Width="Auto" MinWidth="60" />
                    <controls:DataGridTextColumn Header="SDD" Binding="{Binding SddDisplay}" Width="Auto" MinWidth="65" />
                    <controls:DataGridTemplateColumn Header="S" Width="Auto" MinWidth="65" CanUserSort="True" Tag="S">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:BreakpointRow">
                                <Grid Padding="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind SDisplay}" Foreground="{ThemeResource SusceptibleTextBrush}" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                    <controls:DataGridTemplateColumn Header="ECV" Width="Auto" MinWidth="70" CanUserSort="True" Tag="EcvEcoff">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:BreakpointRow">
                                <Grid Padding="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind EcvEcoffDisplay}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                    <controls:DataGridTemplateColumn Header="Comments" Width="Auto" MinWidth="240" CanUserSort="True" Tag="Comments">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:BreakpointRow">
                                <Grid Padding="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Comments}"
                                               ToolTipService.ToolTip="{x:Bind Comments}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </Border>

        <Button x:Name="CloseModalButton"
                Grid.Row="3"
                Content="Close"
                Width="100"
                HorizontalAlignment="Right"
                CornerRadius="4" />
    </Grid>
</ContentDialog>

