<ContentDialog
    x:Class="AMRIE.WinUI.Dialogs.ApplicableBreakpointsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AMRIE.WinUI.Models"
    xmlns:tabular="using:Microsoft.UI.Xaml.Controls.Tabular"
    Style="{StaticResource DefaultContentDialogStyle}"
    Title="Applicable Breakpoints">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1320</x:Double>
    </ContentDialog.Resources>

    <Grid Width="1200" MaxHeight="640" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Context & Filter Summary -->
        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8">
            <StackPanel Spacing="2">
                <TextBlock x:Name="SummaryTextBlock"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           FontWeight="Medium"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="CountTextBlock"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Search & Filter Controls -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox"
                     PlaceholderText="Search within fetched breakpoints (organism, drug, method, guide, site)..."
                     TextChanged="SearchBox_TextChanged" />
            <CheckBox x:Name="HideUndefinedCheck"
                      Grid.Column="1"
                      Content="Hide without breakpoints"
                      ToolTipService.ToolTip="Hide rows where all breakpoints (S, I, R, and SDD) are not available (shown as -)"
                      VerticalAlignment="Center"
                      Checked="HideUndefinedCheck_Changed"
                      Unchecked="HideUndefinedCheck_Changed" />
        </Grid>

        <!-- Breakpoints TableView -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                MinHeight="280"
                MaxHeight="450">
            <tabular:TableView x:Name="BreakpointsTable"
                               SelectionMode="None"
                               CanUserResizeColumns="True">
                <tabular:TableView.Columns>
                    <tabular:TableViewTextColumn Header="Guide" Binding="{Binding Guidelines}" Width="70" FrozenEdge="Leading" />
                    <tabular:TableViewTextColumn Header="Year" Binding="{Binding Year}" Width="60" FrozenEdge="Leading" />
                    <tabular:TableViewTextColumn Header="Method" Binding="{Binding TestMethod}" Width="70" />
                    <tabular:TableViewTextColumn Header="Potency" Binding="{Binding Potency}" Width="75" />
                    <tabular:TableViewTemplateColumn Header="Organism" Width="160" SortMemberPath="OrganismCode">
                        <tabular:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:BreakpointRow">
                                <Grid Padding="12,4" VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind OrganismCode}" FontWeight="Medium" />
                                        <TextBlock Text="{x:Bind OrganismName}"
                                                   ToolTipService.ToolTip="{x:Bind OrganismName}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </tabular:TableViewTemplateColumn.CellTemplate>
                    </tabular:TableViewTemplateColumn>
                    <tabular:TableViewTextColumn Header="Type" Binding="{Binding BreakpointType}" Width="75" />
                    <tabular:TableViewTemplateColumn Header="Site" Width="100" SortMemberPath="SiteOfInfection">
                        <tabular:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:BreakpointRow">
                                <Grid Padding="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind SiteOfInfection}"
                                               ToolTipService.ToolTip="{x:Bind SiteOfInfection}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </tabular:TableViewTemplateColumn.CellTemplate>
                    </tabular:TableViewTemplateColumn>
                                        <tabular:TableViewTemplateColumn Header="Antibiotic" Width="170" SortMemberPath="AbxCode">
                        <tabular:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:BreakpointRow">
                                <Grid Padding="12,4" VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind AbxCode}" FontWeight="Medium" />
                                        <TextBlock Text="{x:Bind AbxName}"
                                                   ToolTipService.ToolTip="{x:Bind AbxName}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </tabular:TableViewTemplateColumn.CellTemplate>
                    </tabular:TableViewTemplateColumn>
                    <tabular:TableViewTemplateColumn Header="R" Width="70" SortMemberPath="R">
                        <tabular:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:BreakpointRow">
                                <Grid Padding="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind RDisplay}" Foreground="{ThemeResource ResistantTextBrush}" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </tabular:TableViewTemplateColumn.CellTemplate>
                    </tabular:TableViewTemplateColumn>
                    <tabular:TableViewTextColumn Header="I" Binding="{Binding IDisplay}" Width="72" />
                    <tabular:TableViewTextColumn Header="SDD" Binding="{Binding SddDisplay}" Width="55" />
                    <tabular:TableViewTemplateColumn Header="S" Width="85" SortMemberPath="S">
                        <tabular:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:BreakpointRow">
                                <Grid Padding="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind SDisplay}" Foreground="{ThemeResource SusceptibleTextBrush}" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </tabular:TableViewTemplateColumn.CellTemplate>
                    </tabular:TableViewTemplateColumn>
                    <tabular:TableViewTemplateColumn Header="ECV" Width="65" SortMemberPath="EcvEcoff">
                        <tabular:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:BreakpointRow">
                                <Grid Padding="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind EcvEcoffDisplay}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </tabular:TableViewTemplateColumn.CellTemplate>
                    </tabular:TableViewTemplateColumn>
                    <tabular:TableViewTemplateColumn Header="Comments" Width="*" SortMemberPath="Comments">
                        <tabular:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:BreakpointRow">
                                <Grid Padding="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Comments}"
                                               ToolTipService.ToolTip="{x:Bind Comments}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </tabular:TableViewTemplateColumn.CellTemplate>
                    </tabular:TableViewTemplateColumn>
                </tabular:TableView.Columns>
            </tabular:TableView>
        </Border>

        <Button x:Name="CloseModalButton"
                Grid.Row="3"
                Content="Close"
                Width="100"
                HorizontalAlignment="Right"
                CornerRadius="4" />
    </Grid>
</ContentDialog>

