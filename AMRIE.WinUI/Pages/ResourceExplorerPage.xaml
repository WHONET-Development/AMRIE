<Page
    x:Class="AMRIE.WinUI.Pages.ResourceExplorerPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AMRIE.WinUI.ViewModels"
    xmlns:models="using:AMRIE.WinUI.Models"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Page.DataContext>
        <vm:ResourceExplorerViewModel x:Name="ViewModel" />
    </Page.DataContext>

    <Grid Padding="28,20,28,28" RowSpacing="16">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearch_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Header -->
        <StackPanel Spacing="4">
            <TextBlock Text="Resource Explorer" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
            <TextBlock Text="Explore and inspect published antibiotic breakpoints, expert interpretation rules, and intrinsic resistance phenotypes."
                       Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Section SelectorBar -->
        <SelectorBar Grid.Row="1"
                     x:Name="SectionSelector"
                     SelectionChanged="SectionSelector_SelectionChanged">
            <SelectorBarItem x:Name="BreakpointsItem" Text="Breakpoints">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE8F1;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="ExpertRulesItem" Text="Expert Rules">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE9D5;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem x:Name="IntrinsicItem" Text="Intrinsic Resistance">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xEA18;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <!-- Controls Bar: Filter Controls (Line 1) + Checkbox & Count Message (Line 2) -->
        <Grid Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Line 1: Search Box + Dropdown Filters -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Filter -->
                <TextBox x:Name="FilterSearchBox"
                         Grid.Column="0"
                         PlaceholderText="Filter by organism name or code, drug, guideline, test, rule... (Ctrl+F)"
                         Text="{x:Bind ViewModel.FilterQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Center" />

                <!-- Organism / Panel Filter ComboBox -->
                <ComboBox Grid.Column="1"
                          ItemsSource="{x:Bind ViewModel.AvailableOrganisms}"
                          SelectedItem="{x:Bind ViewModel.SelectedOrganism, Mode=TwoWay}"
                          DisplayMemberPath="DisplayText"
                          Width="230"
                          VerticalAlignment="Center"
                          Visibility="{x:Bind ViewModel.SelectedSectionIndex, Mode=OneWay, ConverterParameter=0, Converter={StaticResource IntToVisibilityConverter}}" />

                <!-- Guideline Dropdown (CLSI, EUCAST, SFM, All) -->
                <ComboBox Grid.Column="2"
                          ItemsSource="{x:Bind ViewModel.AvailableGuidelines}"
                          SelectedItem="{x:Bind ViewModel.SelectedGuideline, Mode=TwoWay}"
                          Width="140"
                          VerticalAlignment="Center" />

                <!-- Test Method Dropdown (visible for Breakpoints: All Methods, Disk, MIC) -->
                <ComboBox Grid.Column="3"
                          ItemsSource="{x:Bind ViewModel.AvailableTestMethods}"
                          SelectedItem="{x:Bind ViewModel.SelectedTestMethod, Mode=TwoWay}"
                          Width="125"
                          Visibility="{x:Bind ViewModel.SelectedSectionIndex, Mode=OneWay, ConverterParameter=0, Converter={StaticResource IntToVisibilityConverter}}"
                          VerticalAlignment="Center" />

                <!-- Breakpoint Type Dropdown (visible for Breakpoints: All Types, Human, Animal, ECOFF) -->
                <ComboBox Grid.Column="4"
                          ItemsSource="{x:Bind ViewModel.AvailableBreakpointTypes}"
                          SelectedItem="{x:Bind ViewModel.SelectedBreakpointType, Mode=TwoWay}"
                          Width="120"
                          Visibility="{x:Bind ViewModel.SelectedSectionIndex, Mode=OneWay, ConverterParameter=0, Converter={StaticResource IntToVisibilityConverter}}"
                          VerticalAlignment="Center" />

                <!-- Year Dropdown (visible for Breakpoints, no restrict checkbox needed) -->
                <ComboBox Grid.Column="5"
                          ItemsSource="{x:Bind ViewModel.AvailableYears}"
                          SelectedItem="{x:Bind ViewModel.SelectedYear, Mode=TwoWay}"
                          Width="110"
                          Visibility="{x:Bind ViewModel.SelectedSectionIndex, Mode=OneWay, ConverterParameter=0, Converter={StaticResource IntToVisibilityConverter}}"
                          VerticalAlignment="Center" />
            </Grid>

            <!-- Line 2: Hide Undefined Breakpoints CheckBox + Copy Table + Reset Filters + Result Count Message -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Hide rows without S/I/R/SDD breakpoints -->
                <CheckBox Grid.Column="0"
                          Content="Hide without breakpoints"
                          IsChecked="{x:Bind ViewModel.HideUndefinedBreakpoints, Mode=TwoWay}"
                          ToolTipService.ToolTip="Hide rows where all breakpoints (S, I, R, and SDD) are not available (shown as -)"
                          VerticalAlignment="Center"
                          Visibility="{x:Bind ViewModel.SelectedSectionIndex, Mode=OneWay, ConverterParameter=0, Converter={StaticResource IntToVisibilityConverter}}" />

                <!-- Copy Table Button -->
                <Button Grid.Column="1"
                        ToolTipService.ToolTip="Copy the current filtered table to the clipboard (pasteable into Excel/Sheets)"
                        Command="{x:Bind ViewModel.CopyTableCommand}"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                        <TextBlock Text="Copy Table" />
                    </StackPanel>
                </Button>

                <!-- Reset Filters Button -->
                <Button Grid.Column="2"
                        ToolTipService.ToolTip="Reset search and dropdown filters to defaults"
                        Command="{x:Bind ViewModel.ResetFiltersCommand}"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock Text="Reset Filters" />
                    </StackPanel>
                </Button>

                <!-- Count Message (Right-aligned with ample space) -->
                <TextBlock Grid.Column="3"
                           Text="{x:Bind ViewModel.ResultCountMessage, Mode=OneWay}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Grid>

        <!-- Table View Container -->
        <Border Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0">
            <Grid>
                <!-- Section 0: Breakpoints DataGrid -->
                <controls:DataGrid Visibility="{x:Bind ViewModel.SelectedSectionIndex, Mode=OneWay, ConverterParameter=0, Converter={StaticResource IntToVisibilityConverter}}"
                                   ItemsSource="{x:Bind ViewModel.FilteredBreakpoints}"
                                   AutoGenerateColumns="False"
                                   CanUserResizeColumns="True"
                                   CanUserSortColumns="True"
                                   Sorting="DataGrid_Sorting"
                                   IsReadOnly="True"
                                   SelectionMode="Single"
                                   GridLinesVisibility="Horizontal"
                                   HeadersVisibility="Column"
                                   ColumnHeaderHeight="38"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"
                                   HorizontalGridLinesBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                   RowBackground="Transparent"
                                   AlternatingRowBackground="{ThemeResource SubtleFillColorTransparentBrush}"
                                   BorderThickness="0"
                                   Background="Transparent">
                    <controls:DataGrid.Columns>
                        <controls:DataGridTextColumn Header="Guide" Binding="{Binding Guidelines}" Width="Auto" MinWidth="70" />
                        <controls:DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="Auto" MinWidth="60" />
                        <controls:DataGridTextColumn Header="Method" Binding="{Binding TestMethod}" Width="Auto" MinWidth="75" />
                        <controls:DataGridTextColumn Header="Potency" Binding="{Binding Potency}" Width="Auto" MinWidth="75" />
                        <controls:DataGridTemplateColumn Header="Organism" Width="Auto" MinWidth="180" CanUserSort="True" Tag="OrganismCode">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:BreakpointRow">
                                    <Grid Padding="12,4" VerticalAlignment="Center">
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind OrganismCode}" FontWeight="Medium" />
                                            <TextBlock Text="{x:Bind OrganismName}"
                                                       ToolTipService.ToolTip="{x:Bind OrganismName}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind PanelAppliesNote}"
                                                       Visibility="{x:Bind HasPanelAppliesNote, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       ToolTipService.ToolTip="{x:Bind PanelAppliesNote}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                        <controls:DataGridTextColumn Header="Type" Binding="{Binding BreakpointType}" Width="Auto" MinWidth="75" />
                        <controls:DataGridTemplateColumn Header="Antibiotic" Width="Auto" MinWidth="165" CanUserSort="True" Tag="AbxCode">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:BreakpointRow">
                                    <Grid Padding="12,4" VerticalAlignment="Center">
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind AbxCode}" FontWeight="Medium" />
                                            <TextBlock Text="{x:Bind AbxName}"
                                                       ToolTipService.ToolTip="{x:Bind AbxName}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                        <controls:DataGridTemplateColumn Header="R" Width="Auto" MinWidth="65" CanUserSort="True" Tag="R">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:BreakpointRow">
                                    <Grid Padding="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind RDisplay}" Foreground="{ThemeResource ResistantTextBrush}" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                        <controls:DataGridTextColumn Header="I" Binding="{Binding IDisplay}" Width="Auto" MinWidth="55" />
                        <controls:DataGridTextColumn Header="SDD" Binding="{Binding SddDisplay}" Width="Auto" MinWidth="60" />
                        <controls:DataGridTemplateColumn Header="S" Width="Auto" MinWidth="65" CanUserSort="True" Tag="S">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:BreakpointRow">
                                    <Grid Padding="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind SDisplay}" Foreground="{ThemeResource SusceptibleTextBrush}" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                        <controls:DataGridTemplateColumn Header="ECV" Width="Auto" MinWidth="65" CanUserSort="True" Tag="EcvEcoff">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:BreakpointRow">
                                    <Grid Padding="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind EcvEcoffDisplay}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                        <controls:DataGridTextColumn Header="Scope" Binding="{Binding Scope}" CanUserSort="True" Tag="SpecificityRank" Width="Auto" MinWidth="105" />
                        <controls:DataGridTemplateColumn Header="Site" Width="Auto" MinWidth="95" CanUserSort="True" Tag="SiteOfInfection">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:BreakpointRow">
                                    <Grid Padding="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind SiteOfInfection}"
                                                   ToolTipService.ToolTip="{x:Bind SiteOfInfection}" />
                                    </Grid>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                        <controls:DataGridTemplateColumn Header="Comments" Width="Auto" MinWidth="240" CanUserSort="True" Tag="Comments">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:BreakpointRow">
                                    <Grid Padding="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Comments}"
                                                   ToolTipService.ToolTip="{x:Bind Comments}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                    </controls:DataGrid.Columns>
                </controls:DataGrid>

                <!-- Section 1: Expert Rules DataGrid -->
                <controls:DataGrid Visibility="{x:Bind ViewModel.SelectedSectionIndex, Mode=OneWay, ConverterParameter=1, Converter={StaticResource IntToVisibilityConverter}}"
                                   ItemsSource="{x:Bind ViewModel.FilteredExpertRules}"
                                   AutoGenerateColumns="False"
                                   CanUserResizeColumns="True"
                                   CanUserSortColumns="True"
                                   Sorting="DataGrid_Sorting"
                                   IsReadOnly="True"
                                   SelectionMode="Single"
                                   GridLinesVisibility="Horizontal"
                                   HeadersVisibility="Column"
                                   ColumnHeaderHeight="38"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"
                                   HorizontalGridLinesBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                   RowBackground="Transparent"
                                   AlternatingRowBackground="{ThemeResource SubtleFillColorTransparentBrush}"
                                   BorderThickness="0"
                                   Background="Transparent">
                    <controls:DataGrid.Columns>
                        <controls:DataGridTextColumn Header="Guideline" Binding="{Binding Guideline}" Width="Auto" MinWidth="105" />
                        <controls:DataGridTemplateColumn Header="Organism" Width="Auto" MinWidth="190" CanUserSort="True" Tag="OrganismCode">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:ExpertRuleRow">
                                    <Grid Padding="12,4" VerticalAlignment="Center">
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind OrganismCode}" FontWeight="Medium" />
                                            <TextBlock Text="{x:Bind OrganismName}"
                                                       ToolTipService.ToolTip="{x:Bind OrganismName}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                        <controls:DataGridTemplateColumn Header="Affected Drugs" Width="Auto" MinWidth="220" CanUserSort="True" Tag="AffectedAntibiotics">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:ExpertRuleRow">
                                    <Grid Padding="12,6" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind AffectedAntibiotics}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                        <controls:DataGridTemplateColumn Header="Exceptions" Width="Auto" MinWidth="160" CanUserSort="True" Tag="Exceptions">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:ExpertRuleRow">
                                    <Grid Padding="12,6" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Exceptions}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                        <controls:DataGridTemplateColumn Header="Description" Width="Auto" MinWidth="280" CanUserSort="True" Tag="Description">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:ExpertRuleRow">
                                    <Grid Padding="12,6" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                    </controls:DataGrid.Columns>
                </controls:DataGrid>

                <!-- Section 2: Intrinsic Resistance Rules DataGrid -->
                <controls:DataGrid Visibility="{x:Bind ViewModel.SelectedSectionIndex, Mode=OneWay, ConverterParameter=2, Converter={StaticResource IntToVisibilityConverter}}"
                                   ItemsSource="{x:Bind ViewModel.FilteredIntrinsicRules}"
                                   AutoGenerateColumns="False"
                                   CanUserResizeColumns="True"
                                   CanUserSortColumns="True"
                                   Sorting="DataGrid_Sorting"
                                   IsReadOnly="True"
                                   SelectionMode="Single"
                                   GridLinesVisibility="Horizontal"
                                   HeadersVisibility="Column"
                                   ColumnHeaderHeight="38"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"
                                   HorizontalGridLinesBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                   RowBackground="Transparent"
                                   AlternatingRowBackground="{ThemeResource SubtleFillColorTransparentBrush}"
                                   BorderThickness="0"
                                   Background="Transparent">
                    <controls:DataGrid.Columns>
                        <controls:DataGridTextColumn Header="Guideline" Binding="{Binding Guideline}" Width="Auto" MinWidth="105" />
                        <controls:DataGridTemplateColumn Header="Organism" Width="Auto" MinWidth="190" CanUserSort="True" Tag="OrganismCode">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:IntrinsicRuleRow">
                                    <Grid Padding="12,4" VerticalAlignment="Center">
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind OrganismCode}" FontWeight="Medium" />
                                            <TextBlock Text="{x:Bind OrganismName}"
                                                       ToolTipService.ToolTip="{x:Bind OrganismName}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                        <controls:DataGridTemplateColumn Header="Antibiotic" Width="Auto" MinWidth="175" CanUserSort="True" Tag="AbxCode">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:IntrinsicRuleRow">
                                    <Grid Padding="12,4" VerticalAlignment="Center">
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind AbxCode}" FontWeight="Medium" />
                                            <TextBlock Text="{x:Bind AbxName}"
                                                       ToolTipService.ToolTip="{x:Bind AbxName}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                        <controls:DataGridTemplateColumn Header="Exceptions" Width="Auto" MinWidth="160" CanUserSort="True" Tag="Exceptions">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:IntrinsicRuleRow">
                                    <Grid Padding="12,6" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Exceptions}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                        <controls:DataGridTemplateColumn Header="Comments" Width="Auto" MinWidth="280" CanUserSort="True" Tag="Comments">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:IntrinsicRuleRow">
                                    <Grid Padding="12,6" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Comments}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                    </controls:DataGrid.Columns>
                </controls:DataGrid>

                <!-- Loading Overlay -->
                <Grid Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="36" Height="36" />
                        <TextBlock Text="Loading guideline resources..."
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
