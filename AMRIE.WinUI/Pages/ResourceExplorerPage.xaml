<Page
    x:Class="AMRIE.WinUI.Pages.ResourceExplorerPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AMRIE.WinUI.ViewModels"
    xmlns:models="using:AMRIE.WinUI.Models"
    xmlns:tabular="using:Microsoft.UI.Xaml.Controls.Tabular"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Page.DataContext>
        <vm:ResourceExplorerViewModel x:Name="ViewModel" />
    </Page.DataContext>

    <Grid Padding="28,20,28,28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Header -->
        <StackPanel Spacing="4">
            <TextBlock Text="Resource Explorer" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
            <TextBlock Text="Explore and inspect published antibiotic breakpoints, expert interpretation rules, and intrinsic resistance phenotypes."
                       Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Controls Bar: Category Dropdown + Search Box + Guideline Dropdown + Test Method Dropdown + Year Dropdown -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Section / Category Dropdown (Breakpoints, Expert Rules, Intrinsic Resistance) -->
            <ComboBox ItemsSource="{x:Bind ViewModel.AvailableSections}"
                      SelectedItem="{x:Bind ViewModel.SelectedSectionName, Mode=TwoWay}"
                      Width="180"
                      VerticalAlignment="Center" />

            <!-- Search Filter -->
            <TextBox Grid.Column="1"
                     PlaceholderText="Filter by organism name or code, drug, guideline, test, rule..."
                     Text="{x:Bind ViewModel.FilterQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Center" />

            <!-- Guideline Dropdown (CLSI, EUCAST, SFM, All) -->
            <ComboBox Grid.Column="2"
                      ItemsSource="{x:Bind ViewModel.AvailableGuidelines}"
                      SelectedItem="{x:Bind ViewModel.SelectedGuideline, Mode=TwoWay}"
                      Width="150"
                      VerticalAlignment="Center" />

            <!-- Test Method Dropdown (visible for Breakpoints: All Methods, Disk, MIC) -->
            <ComboBox Grid.Column="3"
                      ItemsSource="{x:Bind ViewModel.AvailableTestMethods}"
                      SelectedItem="{x:Bind ViewModel.SelectedTestMethod, Mode=TwoWay}"
                      Width="130"
                      Visibility="{x:Bind ViewModel.SelectedSectionIndex, Mode=OneWay, ConverterParameter=0, Converter={StaticResource IntToVisibilityConverter}}"
                      VerticalAlignment="Center" />

            <!-- Year Dropdown (visible for Breakpoints, no restrict checkbox needed) -->
            <ComboBox Grid.Column="4"
                      ItemsSource="{x:Bind ViewModel.AvailableYears}"
                      SelectedItem="{x:Bind ViewModel.SelectedYear, Mode=TwoWay}"
                      Width="120"
                      Visibility="{x:Bind ViewModel.SelectedSectionIndex, Mode=OneWay, ConverterParameter=0, Converter={StaticResource IntToVisibilityConverter}}"
                      VerticalAlignment="Center" />

            <!-- Count Message -->
            <TextBlock Grid.Column="5"
                       Text="{x:Bind ViewModel.ResultCountMessage, Mode=OneWay}"
                       VerticalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- Table View Container -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0">
            <Grid>
                <!-- Section 0: Breakpoints -->
                <Grid Visibility="{x:Bind ViewModel.SelectedSectionIndex, Mode=OneWay, ConverterParameter=0, Converter={StaticResource IntToVisibilityConverter}}">
                    <tabular:TableView ItemsSource="{x:Bind ViewModel.FilteredBreakpoints}"
                                       SelectionMode="None"
                                       CanUserResizeColumns="True">
                        <tabular:TableView.Columns>
                            <tabular:TableViewTextColumn Header="Guide" Binding="{Binding Guidelines}" Width="70" FrozenEdge="Leading" />
                            <tabular:TableViewTextColumn Header="Year" Binding="{Binding Year}" Width="60" FrozenEdge="Leading" />
                            <tabular:TableViewTextColumn Header="Method" Binding="{Binding TestMethod}" Width="70" />
                            <tabular:TableViewTextColumn Header="Potency" Binding="{Binding Potency}" Width="75" />
                            <tabular:TableViewTemplateColumn Header="Organism" Width="160" SortMemberPath="OrganismCode">
                                <tabular:TableViewTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:BreakpointRow">
                                        <Grid Padding="12,4" VerticalAlignment="Center">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind OrganismCode}" FontWeight="Medium" />
                                                <TextBlock Text="{x:Bind OrganismName}"
                                                           ToolTipService.ToolTip="{x:Bind OrganismName}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </tabular:TableViewTemplateColumn.CellTemplate>
                            </tabular:TableViewTemplateColumn>
                            <tabular:TableViewTextColumn Header="Type" Binding="{Binding BreakpointType}" Width="75" />
                            <tabular:TableViewTemplateColumn Header="Site" Width="100" SortMemberPath="SiteOfInfection">
                                <tabular:TableViewTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:BreakpointRow">
                                        <Grid Padding="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind SiteOfInfection}"
                                                       ToolTipService.ToolTip="{x:Bind SiteOfInfection}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </tabular:TableViewTemplateColumn.CellTemplate>
                            </tabular:TableViewTemplateColumn>
                            <tabular:TableViewTextColumn Header="Antibiotic Code" Binding="{Binding AbxCode}" Width="115" />
                            <tabular:TableViewTemplateColumn Header="R" Width="60" SortMemberPath="R">
                                <tabular:TableViewTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:BreakpointRow">
                                        <Grid Padding="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind RDisplay}" Foreground="#A80000" FontWeight="SemiBold" />
                                        </Grid>
                                    </DataTemplate>
                                </tabular:TableViewTemplateColumn.CellTemplate>
                            </tabular:TableViewTemplateColumn>
                            <tabular:TableViewTextColumn Header="I" Binding="{Binding I}" Width="50" />
                            <tabular:TableViewTextColumn Header="SDD" Binding="{Binding Sdd}" Width="55" />
                            <tabular:TableViewTemplateColumn Header="S" Width="60" SortMemberPath="S">
                                <tabular:TableViewTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:BreakpointRow">
                                        <Grid Padding="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind SDisplay}" Foreground="#107C41" FontWeight="SemiBold" />
                                        </Grid>
                                    </DataTemplate>
                                </tabular:TableViewTemplateColumn.CellTemplate>
                            </tabular:TableViewTemplateColumn>
                            <tabular:TableViewTemplateColumn Header="ECV" Width="65" SortMemberPath="EcvEcoff">
                                <tabular:TableViewTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:BreakpointRow">
                                        <Grid Padding="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind EcvEcoffDisplay}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </tabular:TableViewTemplateColumn.CellTemplate>
                            </tabular:TableViewTemplateColumn>
                            <tabular:TableViewTemplateColumn Header="Comments" Width="*" SortMemberPath="Comments">
                                <tabular:TableViewTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:BreakpointRow">
                                        <Grid Padding="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Comments}"
                                                       ToolTipService.ToolTip="{x:Bind Comments}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </tabular:TableViewTemplateColumn.CellTemplate>
                            </tabular:TableViewTemplateColumn>
                        </tabular:TableView.Columns>
                    </tabular:TableView>
                </Grid>

                <!-- Section 1: Expert Rules -->
                <Grid Visibility="{x:Bind ViewModel.SelectedSectionIndex, Mode=OneWay, ConverterParameter=1, Converter={StaticResource IntToVisibilityConverter}}">
                    <tabular:TableView ItemsSource="{x:Bind ViewModel.FilteredExpertRules}"
                                       SelectionMode="None"
                                       CanUserResizeColumns="True">
                        <tabular:TableView.Columns>
                            <tabular:TableViewTextColumn Header="Rule Code" Binding="{Binding RuleCode}" Width="160" FrozenEdge="Leading" />
                            <tabular:TableViewTemplateColumn Header="Organism" Width="160" SortMemberPath="OrganismCode">
                                <tabular:TableViewTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:ExpertRuleRow">
                                        <Grid Padding="12,4" VerticalAlignment="Center">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind OrganismCode}" FontWeight="Medium" />
                                                <TextBlock Text="{x:Bind OrganismName}"
                                                           ToolTipService.ToolTip="{x:Bind OrganismName}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </tabular:TableViewTemplateColumn.CellTemplate>
                            </tabular:TableViewTemplateColumn>
                            <tabular:TableViewTemplateColumn Header="Affected Drugs" Width="220" SortMemberPath="AffectedAntibiotics">
                                <tabular:TableViewTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:ExpertRuleRow">
                                        <Grid Padding="12,6" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind AffectedAntibiotics}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </tabular:TableViewTemplateColumn.CellTemplate>
                            </tabular:TableViewTemplateColumn>
                            <tabular:TableViewTemplateColumn Header="Exceptions" Width="160" SortMemberPath="Exceptions">
                                <tabular:TableViewTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:ExpertRuleRow">
                                        <Grid Padding="12,6" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Exceptions}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </tabular:TableViewTemplateColumn.CellTemplate>
                            </tabular:TableViewTemplateColumn>
                            <tabular:TableViewTemplateColumn Header="Description" Width="*" SortMemberPath="Description">
                                <tabular:TableViewTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:ExpertRuleRow">
                                        <Grid Padding="12,6" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </tabular:TableViewTemplateColumn.CellTemplate>
                            </tabular:TableViewTemplateColumn>
                        </tabular:TableView.Columns>
                    </tabular:TableView>
                </Grid>

                <!-- Section 2: Intrinsic Resistance Rules -->
                <Grid Visibility="{x:Bind ViewModel.SelectedSectionIndex, Mode=OneWay, ConverterParameter=2, Converter={StaticResource IntToVisibilityConverter}}">
                    <tabular:TableView ItemsSource="{x:Bind ViewModel.FilteredIntrinsicRules}"
                                       SelectionMode="None"
                                       CanUserResizeColumns="True">
                        <tabular:TableView.Columns>
                            <tabular:TableViewTextColumn Header="Guideline" Binding="{Binding Guideline}" Width="100" FrozenEdge="Leading" />
                            <tabular:TableViewTemplateColumn Header="Organism" Width="180" SortMemberPath="OrganismCode" FrozenEdge="Leading">
                                <tabular:TableViewTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:IntrinsicRuleRow">
                                        <Grid Padding="12,4" VerticalAlignment="Center">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind OrganismCode}" FontWeight="Medium" />
                                                <TextBlock Text="{x:Bind OrganismName}"
                                                           ToolTipService.ToolTip="{x:Bind OrganismName}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </tabular:TableViewTemplateColumn.CellTemplate>
                            </tabular:TableViewTemplateColumn>
                            <tabular:TableViewTextColumn Header="Antibiotic" Binding="{Binding AbxCode}" Width="120" />
                            <tabular:TableViewTemplateColumn Header="Exceptions" Width="160" SortMemberPath="Exceptions">
                                <tabular:TableViewTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:IntrinsicRuleRow">
                                        <Grid Padding="12,6" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Exceptions}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </tabular:TableViewTemplateColumn.CellTemplate>
                            </tabular:TableViewTemplateColumn>
                            <tabular:TableViewTemplateColumn Header="Comments" Width="*" SortMemberPath="Comments">
                                <tabular:TableViewTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:IntrinsicRuleRow">
                                        <Grid Padding="12,6" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Comments}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </tabular:TableViewTemplateColumn.CellTemplate>
                            </tabular:TableViewTemplateColumn>
                        </tabular:TableView.Columns>
                    </tabular:TableView>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
