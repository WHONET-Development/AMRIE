<Page
    x:Class="AMRIE.WinUI.Pages.ResourceExplorerPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AMRIE.WinUI.ViewModels"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Page.DataContext>
        <vm:ResourceExplorerViewModel x:Name="ViewModel" />
    </Page.DataContext>

    <Grid Padding="28,20,28,28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Header -->
        <StackPanel Spacing="4">
            <TextBlock Text="Resource Explorer" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
            <TextBlock Text="Explore and inspect published antibiotic breakpoints, expert interpretation rules, and intrinsic resistance phenotypes."
                       Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Controls Bar: Category Dropdown + Search Box + Guideline Dropdown + Test Method Dropdown + Year Dropdown -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Section / Category Dropdown (Breakpoints, Expert Rules, Intrinsic Resistance) -->
            <ComboBox ItemsSource="{x:Bind ViewModel.AvailableSections}"
                      SelectedItem="{x:Bind ViewModel.SelectedSectionName, Mode=TwoWay}"
                      Width="180"
                      VerticalAlignment="Center" />

            <!-- Search Filter -->
            <TextBox Grid.Column="1"
                     PlaceholderText="Filter by organism name or code, drug, guideline, test, rule..."
                     Text="{x:Bind ViewModel.FilterQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Center" />

            <!-- Guideline Dropdown (CLSI, EUCAST, SFM, All) -->
            <ComboBox Grid.Column="2"
                      ItemsSource="{x:Bind ViewModel.AvailableGuidelines}"
                      SelectedItem="{x:Bind ViewModel.SelectedGuideline, Mode=TwoWay}"
                      Width="150"
                      VerticalAlignment="Center" />

            <!-- Test Method Dropdown (visible for Breakpoints: All Methods, Disk, MIC) -->
            <ComboBox Grid.Column="3"
                      ItemsSource="{x:Bind ViewModel.AvailableTestMethods}"
                      SelectedItem="{x:Bind ViewModel.SelectedTestMethod, Mode=TwoWay}"
                      Width="130"
                      Visibility="{x:Bind ViewModel.SelectedSectionIndex, Mode=OneWay, ConverterParameter=0, Converter={StaticResource IntToVisibilityConverter}}"
                      VerticalAlignment="Center" />

            <!-- Year Dropdown (visible for Breakpoints, no restrict checkbox needed) -->
            <ComboBox Grid.Column="4"
                      ItemsSource="{x:Bind ViewModel.AvailableYears}"
                      SelectedItem="{x:Bind ViewModel.SelectedYear, Mode=TwoWay}"
                      Width="120"
                      Visibility="{x:Bind ViewModel.SelectedSectionIndex, Mode=OneWay, ConverterParameter=0, Converter={StaticResource IntToVisibilityConverter}}"
                      VerticalAlignment="Center" />

            <!-- Count Message -->
            <TextBlock Grid.Column="5"
                       Text="{x:Bind ViewModel.ResultCountMessage, Mode=OneWay}"
                       VerticalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <!-- Table View Container -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="0">
            <Grid>
                <!-- Section 0: Breakpoints -->
                <Grid Visibility="{x:Bind ViewModel.SelectedSectionIndex, Mode=OneWay, ConverterParameter=0, Converter={StaticResource IntToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Column Headers Header Grid -->
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,0">
                        <Grid ColumnSpacing="10" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="55" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="65" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="45" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="55" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Guide" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Year" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Method" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Potency" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="Organism" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="5" Text="Type" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="6" Text="Site" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="7" Text="WHONET Test" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="8" Text="R" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="9" Text="I" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="10" Text="SDD" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="11" Text="S" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="12" Text="ECV" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="13" Text="Comments" FontWeight="SemiBold" />
                        </Grid>
                    </Border>

                    <!-- Breakpoints ListView -->
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.FilteredBreakpoints}"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BreakpointRow">
                                <Grid ColumnSpacing="10" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="55" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="45" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="55" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Guidelines}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Year}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind TestMethod}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Potency}" />
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind OrganismCode}" FontWeight="Medium" />
                                        <TextBlock Text="{x:Bind OrganismName}"
                                                   ToolTipService.ToolTip="{x:Bind OrganismName}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="5" Text="{x:Bind BreakpointType}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="6"
                                               Text="{x:Bind SiteOfInfection}"
                                               ToolTipService.ToolTip="{x:Bind SiteOfInfection}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="7" Text="{x:Bind WhonetTest}" />
                                    <TextBlock Grid.Column="8" Text="{x:Bind RDisplay}" Foreground="#A80000" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="9" Text="{x:Bind I}" />
                                    <TextBlock Grid.Column="10" Text="{x:Bind Sdd}" />
                                    <TextBlock Grid.Column="11" Text="{x:Bind SDisplay}" Foreground="#107C41" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="12" Text="{x:Bind EcvEcoffDisplay}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Grid.Column="13"
                                               Text="{x:Bind Comments}"
                                               ToolTipService.ToolTip="{x:Bind Comments}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Section 1: Expert Rules -->
                <Grid Visibility="{x:Bind ViewModel.SelectedSectionIndex, Mode=OneWay, ConverterParameter=1, Converter={StaticResource IntToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,0">
                        <Grid ColumnSpacing="16" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Rule Code" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Organism" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Affected Drugs" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Exceptions" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="Description" FontWeight="SemiBold" />
                        </Grid>
                    </Border>

                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.FilteredExpertRules}"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExpertRuleRow">
                                <Grid ColumnSpacing="16" Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind RuleCode}" FontWeight="SemiBold" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind OrganismCode}" FontWeight="Medium" />
                                        <TextBlock Text="{x:Bind OrganismName}"
                                                   ToolTipService.ToolTip="{x:Bind OrganismName}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind AffectedAntibiotics}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Exceptions}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Description}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Section 2: Intrinsic Resistance Rules -->
                <Grid Visibility="{x:Bind ViewModel.SelectedSectionIndex, Mode=OneWay, ConverterParameter=2, Converter={StaticResource IntToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,0">
                        <Grid ColumnSpacing="16" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Guideline" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Organism" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Antibiotic" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Exceptions" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="Comments" FontWeight="SemiBold" />
                        </Grid>
                    </Border>

                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.FilteredIntrinsicRules}"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:IntrinsicRuleRow">
                                <Grid ColumnSpacing="16" Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Guideline}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind OrganismCode}" FontWeight="Medium" />
                                        <TextBlock Text="{x:Bind OrganismName}"
                                                   ToolTipService.ToolTip="{x:Bind OrganismName}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind AbxCode}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Exceptions}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Comments}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
