<Page
    x:Class="AMRIE.WinUI.Pages.SingleInterpretationPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AMRIE.WinUI.ViewModels"
    xmlns:models="using:AMRIE.WinUI.Models"
    mc:Ignorable="d">

    <Page.DataContext>
        <vm:SingleInterpretationViewModel x:Name="ViewModel" />
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,20">
        <StackPanel Spacing="14" HorizontalAlignment="Stretch">

            <!-- Title Header & Status -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="Single Test Interpretation" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                    <TextBlock Text="Perform ad-hoc interpretation of antimicrobial measurements against published CLSI, EUCAST, and SFM rules."
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button ToolTipService.ToolTip="Load a standard test case (S. pneumoniae + Amoxicillin/Clavulanic acid MIC 2 µg/mL)"
                            Command="{x:Bind ViewModel.LoadExampleCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8B9;" FontSize="12" />
                            <TextBlock Text="Try an Example" />
                        </StackPanel>
                    </Button>
                    <Button ToolTipService.ToolTip="Clear organism, antibiotic, measurement, and results"
                            Command="{x:Bind ViewModel.ClearInputsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE894;" FontSize="12" />
                            <TextBlock Text="Clear" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Status Alert (InfoBar) -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=TwoWay}"
                     Severity="{x:Bind ViewModel.StatusInfoBarSeverity, Mode=OneWay}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     IsClosable="True"
                     Margin="0,0,0,2" />

            <!-- Main 2-Column Responsive Layout -->
            <Grid ColumnSpacing="16" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" MinWidth="360" />
                    <ColumnDefinition Width="0.9*" MinWidth="340" />
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: Card 1 (Criteria) & Card 2 (Target Microorganism & Agent) -->
                <StackPanel Spacing="14">
                    
                    <!-- Card 1: Guideline & Breakpoint Criteria -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14">
                        <StackPanel Spacing="10">
                            <!-- Year restriction header row -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Content="Restrict guideline year" VerticalContentAlignment="Center" 
                                          IsChecked="{x:Bind ViewModel.RestrictGuidelineYear, Mode=TwoWay}"
                                          FontWeight="SemiBold"
                                          VerticalAlignment="Center" />

                                <ComboBox Grid.Column="1"
                                          ItemsSource="{x:Bind ViewModel.AvailableYears}"
                                          SelectedItem="{x:Bind ViewModel.GuidelineYear, Mode=TwoWay}"
                                          IsEnabled="{x:Bind ViewModel.RestrictGuidelineYear, Mode=OneWay}"
                                          Width="105"
                                          VerticalAlignment="Center" />
                            </Grid>

                            <!-- 3 Restriction Boxes: Side-by-Side with equal height -->
                            <Grid ColumnSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="124" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Column 1: Guidelines Header & Box -->
                                <CheckBox Grid.Row="0" Grid.Column="0"
                                          Content="Guidelines"
                                          IsChecked="{x:Bind ViewModel.RestrictGuidelines, Mode=TwoWay}"
                                          VerticalContentAlignment="Center"
                                          FontWeight="SemiBold"
                                          Margin="0,0,0,4" />
                                <Border Grid.Row="1" Grid.Column="0"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        CornerRadius="4"
                                        Padding="8,4">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.Guidelines}"
                                                  IsEnabled="{x:Bind ViewModel.RestrictGuidelines, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:SelectableItem">
                                                <CheckBox Content="{x:Bind Name}" VerticalContentAlignment="Center"
                                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                          Margin="0,0,0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <!-- Column 2: Breakpoint Types Header & Box (priority-ordered) -->
                                <CheckBox Grid.Row="0" Grid.Column="1"
                                          Content="Types (Priority)"
                                          IsChecked="{x:Bind ViewModel.RestrictBreakpointTypes, Mode=TwoWay}"
                                          ToolTipService.ToolTip="Drag items or use arrows to set priority order"
                                          VerticalContentAlignment="Center"
                                          FontWeight="SemiBold"
                                          Margin="0,0,0,4" />
                                <Border Grid.Row="1" Grid.Column="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        CornerRadius="4"
                                        Padding="4,2">
                                    <ListView ItemsSource="{x:Bind ViewModel.BreakpointTypes}"
                                              IsEnabled="{x:Bind ViewModel.RestrictBreakpointTypes, Mode=OneWay}"
                                              CanDragItems="True"
                                              CanReorderItems="True"
                                              AllowDrop="True"
                                              SelectionMode="None">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="MinHeight" Value="28" />
                                                <Setter Property="Padding" Value="4,0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:SelectableItem">
                                                <Grid ColumnSpacing="5" Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Grid.Column="0" Glyph="&#xE700;" FontSize="10"
                                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                              VerticalAlignment="Center" Margin="2,0,0,0" />
                                                    <CheckBox Grid.Column="1"
                                                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                              MinWidth="0" MinHeight="0" Padding="0"
                                                              VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{x:Bind Name}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="3" Padding="4,2" Background="Transparent" BorderThickness="0"
                                                            Tag="{x:Bind}" Click="MoveTypeUp_Click" ToolTipService.ToolTip="Move higher in priority">
                                                        <FontIcon Glyph="&#xE70E;" FontSize="9" />
                                                    </Button>
                                                    <Button Grid.Column="4" Padding="4,2" Background="Transparent" BorderThickness="0"
                                                            Tag="{x:Bind}" Click="MoveTypeDown_Click" ToolTipService.ToolTip="Move lower in priority">
                                                        <FontIcon Glyph="&#xE70D;" FontSize="9" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Border>

                                <!-- Column 3: Sites of Infection Header & Box (priority-ordered) -->
                                <CheckBox Grid.Row="0" Grid.Column="2"
                                          Content="Sites (Priority)"
                                          IsChecked="{x:Bind ViewModel.RestrictSitesOfInfection, Mode=TwoWay}"
                                          ToolTipService.ToolTip="Drag items or use arrows to set priority order"
                                          VerticalContentAlignment="Center"
                                          FontWeight="SemiBold"
                                          Margin="0,0,0,4" />
                                <Border Grid.Row="1" Grid.Column="2"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        CornerRadius="4"
                                        Padding="4,2">
                                    <ListView ItemsSource="{x:Bind ViewModel.SitesOfInfection}"
                                              IsEnabled="{x:Bind ViewModel.RestrictSitesOfInfection, Mode=OneWay}"
                                              CanDragItems="True"
                                              CanReorderItems="True"
                                              AllowDrop="True"
                                              SelectionMode="None">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="MinHeight" Value="28" />
                                                <Setter Property="Padding" Value="4,0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:SelectableItem">
                                                <Grid ColumnSpacing="5" Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Grid.Column="0" Glyph="&#xE700;" FontSize="10"
                                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                              VerticalAlignment="Center" Margin="2,0,0,0" />
                                                    <CheckBox Grid.Column="1"
                                                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                              MinWidth="0" MinHeight="0" Padding="0"
                                                              VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{x:Bind Name}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="3" Padding="4,2" Background="Transparent" BorderThickness="0"
                                                            Tag="{x:Bind}" Click="MoveSiteUp_Click" ToolTipService.ToolTip="Move higher in priority">
                                                        <FontIcon Glyph="&#xE70E;" FontSize="9" />
                                                    </Button>
                                                    <Button Grid.Column="4" Padding="4,2" Background="Transparent" BorderThickness="0"
                                                            Tag="{x:Bind}" Click="MoveSiteDown_Click" ToolTipService.ToolTip="Move lower in priority">
                                                        <FontIcon Glyph="&#xE70D;" FontSize="9" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Microorganism & Antimicrobial Agent -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14">
                        <StackPanel Spacing="12">
                            <!-- Organism search -->
                            <StackPanel Spacing="2">
                                <AutoSuggestBox x:Name="OrganismSuggestBox"
                                                Header="Microorganism"
                                                Text="{x:Bind ViewModel.OrganismSearchText, Mode=TwoWay}"
                                                PlaceholderText="Search name or code (e.g. Escherichia coli, ECO)..."
                                                TextChanged="OrganismSuggestBox_TextChanged"
                                                SuggestionChosen="OrganismSuggestBox_SuggestionChosen"
                                                QuerySubmitted="OrganismSuggestBox_QuerySubmitted"
                                                QueryIcon="Find">
                                    <AutoSuggestBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:OrganismItem">
                                            <Grid ColumnSpacing="8" Padding="2,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                                <!-- Code Badge -->
                                                <Border Grid.Column="1"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="4"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Code}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </AutoSuggestBox.ItemTemplate>
                                </AutoSuggestBox>
                                <TextBlock Text="{x:Bind ViewModel.SelectedOrganism.DisplayName, Mode=OneWay, FallbackValue='No organism selected'}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           Margin="2,1,0,0" />
                            </StackPanel>

                            <!-- Antibiotic search -->
                            <StackPanel Spacing="2">
                                <AutoSuggestBox x:Name="AntibioticSuggestBox"
                                                Header="Antimicrobial Agent"
                                                Text="{x:Bind ViewModel.AntibioticSearchText, Mode=TwoWay}"
                                                PlaceholderText="Search antibiotic name, code (e.g. AMK), or user-defined (e.g. X_1, X_12)..."
                                                ToolTipService.ToolTip="Search by antibiotic name, 3-letter WHONET code (e.g. AMK), or user-defined antibiotic code (X_1 to X_99)."
                                                TextChanged="AntibioticSuggestBox_TextChanged"
                                                SuggestionChosen="AntibioticSuggestBox_SuggestionChosen"
                                                QuerySubmitted="AntibioticSuggestBox_QuerySubmitted"
                                                QueryIcon="Find">
                                    <AutoSuggestBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:AntibioticItem">
                                            <Grid ColumnSpacing="8" Padding="2,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                                <!-- Code Badge -->
                                                <Border Grid.Column="1"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="4"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Code}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </AutoSuggestBox.ItemTemplate>
                                </AutoSuggestBox>
                                <TextBlock Text="{x:Bind ViewModel.SelectedAntibiotic.DisplayName, Mode=OneWay, FallbackValue='No antibiotic selected'}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           Margin="2,1,0,0" />
                            </StackPanel>

                            <!-- Test Method: Disk vs MIC -->
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Method" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <RadioButton Content="Disk" VerticalContentAlignment="Center" IsChecked="{x:Bind ViewModel.IsDiskMethod, Mode=TwoWay}" GroupName="TestMethodGroup" />
                                        <RadioButton Content="MIC / Etest" VerticalContentAlignment="Center" IsChecked="{x:Bind ViewModel.IsMicMethod, Mode=TwoWay}" GroupName="TestMethodGroup" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Potency dropdown (visible when disk) -->
                                <ComboBox Grid.Column="1"
                                          Header="Potency"
                                          ItemsSource="{x:Bind ViewModel.DiskPotencies}"
                                          SelectedItem="{x:Bind ViewModel.SelectedDiskPotency, Mode=TwoWay}"
                                          PlaceholderText="Select potency"
                                          HorizontalAlignment="Stretch"
                                          Visibility="{x:Bind ViewModel.IsDiskMethod, Mode=OneWay}" />
                            </Grid>

                            <!-- Quick Applicable Lookup Buttons -->
                            <MenuFlyoutSeparator Margin="0,6,0,2" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        Click="GetApplicableBreakpoints_Click"
                                        ToolTipService.ToolTip="View applicable breakpoints for current organism/antibiotic/filters">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE8F1;" FontSize="13" />
                                        <TextBlock Text="Breakpoints" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        Click="GetApplicableExpertRules_Click"
                                        ToolTipService.ToolTip="View applicable expert interpretation rules for current organism/antibiotic/filters">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE9D5;" FontSize="13" />
                                        <TextBlock Text="Expert Rules" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        HorizontalAlignment="Stretch"
                                        Click="GetApplicableIntrinsicResistance_Click"
                                        ToolTipService.ToolTip="View applicable intrinsic resistance phenotypes for current organism/antibiotic/filters">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xEA18;" FontSize="13" />
                                        <TextBlock Text="Intrinsic Rules" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT COLUMN: Card 3 (Measurement Input, Interpret Action & Results) -->
                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,14">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Measurement &amp; Results" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />

                        <!-- Measurement input & interpret button -->
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Header="Measurement Value"
                                     PlaceholderText="e.g. 22 (mm) or &lt;=0.5 (mg/L)"
                                     Text="{x:Bind ViewModel.Measurement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="MeasurementTextBox_KeyDown" />

                            <Button Grid.Column="1"
                                    VerticalAlignment="Bottom"
                                    Height="32"
                                    Content="Interpret"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.InterpretCommand}"
                                    Padding="20,0" />
                        </Grid>

                        <!-- Engine options checkboxes -->
                        <StackPanel Spacing="2">
                            <CheckBox Content="Include interpretation comments" VerticalContentAlignment="Center"
                                      IsChecked="{x:Bind ViewModel.IncludeComments, Mode=TwoWay}" />
                            <CheckBox Content="Round half-dilutions (MIC)" VerticalContentAlignment="Center"
                                      IsChecked="{x:Bind ViewModel.RoundHalfDilutions, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.IsMicMethod, Mode=OneWay}"
                                      ToolTipService.ToolTip="Round intermediate MIC values up to the next standard two-fold dilution before interpretation" />
                            <CheckBox Content="Apply intrinsic resistance rules" VerticalContentAlignment="Center"
                                      IsChecked="{x:Bind ViewModel.UseIntrinsicResistanceRules, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Override susceptibility results using expected intrinsic resistance phenotype rules" />
                        </StackPanel>

                        <!-- Interpretation Results Display -->
                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Results.Count, Mode=OneWay, Converter={StaticResource IntToVisibilityConverter}, FallbackValue=Collapsed}">
                            <MenuFlyoutSeparator />
                            <Grid>
                                <TextBlock Text="Results" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <Button Command="{x:Bind ViewModel.CopyResultsCommand}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Copy interpretation results to clipboard">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                        <TextBlock Text="Copy Results" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Results}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:InterpretationResultItem">
                                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12,10"
                                                    Margin="0,0,0,8">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Badge (S / I / R) -->
                                                    <Border CornerRadius="6"
                                                            Padding="12,6"
                                                            VerticalAlignment="Center"
                                                            Background="{x:Bind BadgeBackground}">
                                                        <TextBlock Text="{x:Bind ResultBadge}"
                                                                   FontWeight="Bold"
                                                                   FontSize="18"
                                                                   Foreground="{x:Bind BadgeForeground}"
                                                                   HorizontalAlignment="Center" />
                                                    </Border>

                                                    <!-- Details -->
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind TestCode}" FontWeight="SemiBold" Style="{ThemeResource BodyStrongTextBlockStyle}" IsTextSelectionEnabled="True" />
                                                        <TextBlock Text="{x:Bind Interpretation}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
