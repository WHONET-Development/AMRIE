<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AMRIE.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AMRIE.WinUI"
    xmlns:common="using:AMRIE.WinUI.Common">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <common:IntToVisibilityConverter x:Key="IntToVisibilityConverter" />
            <common:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

            <!-- Consistent input field styling across the app -->
            <Style TargetType="TextBox">
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <Style TargetType="AutoSuggestBox">
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <Style TargetType="NumberBox">
                <Setter Property="CornerRadius" Value="4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
