<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>AMRIE.CLI</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AMRIE.CLI</RootNamespace>
    <Version>$(VersionPrefix)26.3.26</Version>
    <ApplicationIcon>AMRIE_Square_No_Text.ico</ApplicationIcon>
    <AssemblyTitle>AMRIE.CLI</AssemblyTitle>
    <Title>AMRIE CLI</Title>
    <Company />
    <Authors>$(Authors)</Authors>
    <StartupObject>AMRIE.CLI.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="AMRIE_Square_No_Text.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AMRIE.Library\AMRIE.Library.csproj" />
  </ItemGroup>


  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="if $(ConfigurationName) == Release (&#xD;&#xA;echo Attempting to sign binary...&#xD;&#xA;signtool.exe sign /tr http://timestamp.sectigo.com /td sha256 /fd sha256 /a &quot;$(TargetDir)$(TargetName).exe&quot;&#xD;&#xA;) else (&#xD;&#xA;echo Signing skipped because we are not in Release mode.&#xD;&#xA;)" />
  </Target>

</Project>
