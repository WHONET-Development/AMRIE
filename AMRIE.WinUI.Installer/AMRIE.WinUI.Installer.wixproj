<Project Sdk="WixToolset.Sdk/5.0.1">
  <PropertyGroup>
    <OutputName>AMR_Interpretation_Engine_WinUI_$(Platform)</OutputName>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
    <SuppressIces>ICE03;ICE61</SuppressIces>
  </PropertyGroup>
  <PropertyGroup>
    <BuildDate Condition="'$(BuildDate)' == ''">$([System.DateTime]::Now.ToString("dd-MM-yyyy"))</BuildDate>
    <Version Condition="'$(Version)' == ''">$([System.DateTime]::Now.ToString("yy.M.d"))</Version>
    <Title>AMR Interpretation Engine</Title>
    <Manufacturer>Brigham and Women's Hospital</Manufacturer>
    <WinUIRuntimeIdentifier>win-$([System.String]::Copy('$(Platform)').ToLowerInvariant())</WinUIRuntimeIdentifier>
    <WinUIPublishDir>..\AMRIE.WinUI\bin\$(Platform)\$(Configuration)\net8.0-windows10.0.26100.0\$(WinUIRuntimeIdentifier)\publish</WinUIPublishDir>
    <CLIPublishDir>..\Interpretation CLI\bin\$(Platform)\$(Configuration)\net8.0\$(WinUIRuntimeIdentifier)</CLIPublishDir>
    <DefineConstants>Title=$(Title);Version=$(Version);BuildDate=$(BuildDate);WinUIPublishDir=$(WinUIPublishDir);CLIPublishDir=$(CLIPublishDir)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
  <!-- Pre-build publish of AMRIE.WinUI (unpackaged, self-contained) and CLI -->
  <Target Name="PublishDependencies" BeforeTargets="BeforeBuild">
    <MakeDir Directories="$(IntermediateOutputPath)en-us" />
    <Message Importance="high" Text="Publishing AMRIE.WinUI (win-$(Platform) $(Configuration))..." />
    <MSBuild Projects="..\AMRIE.WinUI\AMRIE.WinUI.csproj" Targets="Publish" Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=$(WinUIRuntimeIdentifier);WindowsPackageType=None;WindowsAppSDKSelfContained=true;SelfContained=true" />
    <Message Importance="high" Text="Building self-contained Interpretation CLI ($(Platform) $(Configuration))..." />
    <MSBuild Projects="..\Interpretation CLI\Interpretation CLI.csproj" Targets="Restore;Build" Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=$(WinUIRuntimeIdentifier);SelfContained=true" />
  </Target>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="where signtool.exe &gt;nul 2&gt;&amp;1 &amp;&amp; (echo Attempting to sign installer package... &amp; signtool.exe sign /tr http://timestamp.sectigo.com /td sha256 /fd sha256 /d &quot;AMRIE WinUI&quot; /a &quot;$(TargetDir)en-us\$(TargetName).msi&quot;) || (echo Signtool not found or signing skipped.)" ContinueOnError="true" />
  </Target>
</Project>